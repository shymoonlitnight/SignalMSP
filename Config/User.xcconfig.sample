OTHER_SWIFT_FLAGS = $(inherited) -no-warnings-as-errors

// To use a test input file for the camera, uncomment the below line, uncomment
// the relevant line in the Podfile to set RINGRTC_USE_FILE_BASED_CAMERA, and
// put a video file at the below location
// MAYBE_INPUT_VIDEO_PATH = Signal/test/Assets/input_video.mp4

// Personal signing (SignalMSP fork, see Fork/README.md). Uncomment and fill in
// to sign with your own team; when unset, the upstream defaults from
// Project.xcconfig apply.
// DEVELOPMENT_TEAM = ABCDE12345                        // your team ID
// SIGNAL_BUNDLEID_PREFIX = org.example                 // app, extensions, App Group
// SIGNAL_ORG_BUNDLEID_PREFIX = $(SIGNAL_BUNDLEID_PREFIX) // frameworks and test bundles
// SIGNAL_MERCHANTID = org.example                      // Apple Pay merchant ID suffix
// SIGNAL_APP_NAME = SignalMSP                          // home-screen name
